GROQ_API_KEY=
LLM_PROVIDER=groq
# Set an available model ID from your provider account. No implicit model default.
LLM_MODEL=openai/gpt-oss-120b
# Optional per-agent overrides: MODEL_ANALYST, MODEL_ARCHITECT, MODEL_DEVELOPER
DATABASE_URL=sqlite:///.cortexforge/state.db
EXECUTION_MODE=docker
MAX_REPAIR_ATTEMPTS=3
SANDBOX_IMAGE=cortexforge-sandbox:local
# Optional USD per million tokens; absent means unknown cost.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
# Set a private random token before starting API; never give it to the model.
REVIEW_TOKEN=

LLM_MAX_OUTPUT_TOKENS=2048
