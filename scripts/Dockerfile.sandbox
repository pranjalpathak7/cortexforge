FROM python:3.12-slim
RUN pip install --no-cache-dir pytest==8.3.5 ruff==0.11.13 bandit==1.8.3
RUN pip install --no-cache-dir fastapi==0.115.12 httpx==0.28.1
# Upgrade the vulnerable baseline test runner in the final runnable image.
RUN pip install --no-cache-dir --upgrade pytest==9.2.0 fastapi==0.165.0 starlette==1.10.0 httpx==0.28.1 pydantic==2.14.4
ENV PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
WORKDIR /workspace
USER 65534:65534

